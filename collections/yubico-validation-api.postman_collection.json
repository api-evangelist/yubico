  "item": [
    {
      "id": "a31279af-f708-48f2-acf2-b62d17ffe6eb",
      "name": "Validation",
      "description": {
        "content": "Yubico OTP validation operations.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "08075eeb-cdf0-44a8-9e95-de4d6fdae990",
          "name": "Verify a Yubico OTP",
          "request": {
            "name": "Verify a Yubico OTP",
            "description": {
              "content": "Validate a 44-character ModHex Yubico OTP against YubiCloud. The service returns a signed status indicating whether the OTP is valid, replayed, or malformed. Always verify the response signature (h) and confirm the returned nonce matches the nonce that was sent.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) Numeric Client ID obtained from the Yubico API key generator."
                },
                {
                  "disabled": false,
                  "key": "otp",
                  "value": "<string>",
                  "description": "(Required) The 44-character ModHex-encoded OTP emitted by the YubiKey."
                },
                {
                  "disabled": false,
                  "key": "nonce",
                  "value": "<string>",
                  "description": "(Required) Unique random string of 16 to 40 alphanumeric characters, used to protect against replay of the request/response pair."
                },
                {
                  "disabled": false,
                  "key": "h",
                  "value": "<string>",
                  "description": "Optional Base64-encoded HMAC-SHA1 signature of the request parameters using the client's shared secret. Recommended for production."
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<integer>",
                  "description": "Set to 1 to request the YubiKey internal timestamp and session counters in the response."
                },
                {
                  "disabled": false,
                  "key": "sl",
                  "value": "<string>",
                  "description": "Requested percentage of syncing servers that must agree before a response is returned. Integer 0-100 or the strings \"fast\" or \"secure\"."
                },
                {
                  "disabled": false,
                  "key": "timeout",
                  "value": "<integer>",
                  "description": "Number of seconds to wait for sync responses before returning."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a30dc9d1-54cc-448a-87dd-1ef7b3445b37",
              "name": "A signed plain-text response. The overall outcome is carried in the status field; the HTTP status is 200 even for invalid OTPs.",
              "originalRequest": {
                "url": {
                  "path": [
                    "verify"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "id",
