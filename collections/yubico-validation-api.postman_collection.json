                    },
                    {
                      "key": "h",
                      "value": "<string>"
                    },
                    {
                      "key": "timestamp",
                      "value": "<integer>"
                    },
                    {
                      "key": "sl",
                      "value": "<string>"
                    },
                    {
                      "key": "timeout",
                      "value": "<integer>"
                    },
                    {
                      "key": "id",
                      "value": "<API Key>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
