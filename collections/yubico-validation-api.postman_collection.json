  },
  "item": [
    {
      "name": "verify",
      "item": [
        {
          "name": "Verify a Yubico OTP",
          "id": "a558744f-d423-4743-8f8c-8df7824035f9",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/verify?id=<string>&otp=<string>&nonce=6mzGLCDwUkHoOFkBAJmjGvzp&h=<string>&timestamp=1&sl=<string>&timeout=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify"
              ],
              "query": [
                {
                  "description": "(Required) Numeric Client ID obtained from the Yubico API key generator.",
                  "key": "id",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The 44-character ModHex-encoded OTP emitted by the YubiKey.",
                  "key": "otp",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Unique random string of 16 to 40 alphanumeric characters, used to protect against replay of the request/response pair.",
                  "key": "nonce",
                  "value": "6mzGLCDwUkHoOFkBAJmjGvzp"
                },
                {
                  "description": "Optional Base64-encoded HMAC-SHA1 signature of the request parameters using the client's shared secret. Recommended for production.",
                  "key": "h",
                  "value": "<string>"
                },
                {
                  "description": "Set to 1 to request the YubiKey internal timestamp and session counters in the response.",
                  "key": "timestamp",
                  "value": "1"
                },
                {
                  "description": "Requested percentage of syncing servers that must agree before a response is returned. Integer 0-100 or the strings \"fast\" or \"secure\".",
                  "key": "sl",
                  "value": "<string>"
                },
                {
                  "description": "Number of seconds to wait for sync responses before returning.",
                  "key": "timeout",
                  "value": "<integer>"
                }
              ]
            },
            "description": "Validate a 44-character ModHex Yubico OTP against YubiCloud. The service returns a signed status indicating whether the OTP is valid, replayed, or malformed. Always verify the response signature (h) and confirm the returned nonce matches the nonce that was sent."
          },
          "response": [
            {
              "id": "765a0134-29a1-44cd-b1dd-02848406d1d4",
              "name": "A signed plain-text response. The overall outcome is carried in the status field; the HTTP status is 200 even for invalid OTPs.",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/verify?id=<API Key>&otp=<string>&nonce=6mzGLCDwUkHoOFkBAJmjGvzp&h=<string>&timestamp=1&sl=<string>&timeout=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "verify"
                  ],
                  "query": [
                    {
                      "description": "(Required) Numeric Client ID obtained from the Yubico API key generator.",
                      "key": "id",
                      "value": "<API Key>"
                    },
                    {
                      "description": "(Required) The 44-character ModHex-encoded OTP emitted by the YubiKey.",
                      "key": "otp",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Unique random string of 16 to 40 alphanumeric characters, used to protect against replay of the request/response pair.",
                      "key": "nonce",
                      "value": "6mzGLCDwUkHoOFkBAJmjGvzp"
                    },
                    {
                      "description": "Optional Base64-encoded HMAC-SHA1 signature of the request parameters using the client's shared secret. Recommended for production.",
                      "key": "h",
                      "value": "<string>"
                    },
                    {
                      "description": "Set to 1 to request the YubiKey internal timestamp and session counters in the response.",
                      "key": "timestamp",
                      "value": "1"
                    },
                    {
                      "description": "Requested percentage of syncing servers that must agree before a response is returned. Integer 0-100 or the strings \"fast\" or \"secure\".",
                      "key": "sl",
                      "value": "<string>"
                    },
                    {
                      "description": "Number of seconds to wait for sync responses before returning.",
                      "key": "timeout",
                      "value": "<integer>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "text",
